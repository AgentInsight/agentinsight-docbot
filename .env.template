# agentinsight-docbot 环境变量模板
# 复制为 .env 并填入真实凭据
#
# 与 agentinsight-researcher 的差异:
# - 移除: 搜索引擎 API Key (Tavily/Brave/SerpApi/Exa 等) + SearxNG + 抓取配置 (FIRECRAWL/MAX_SCRAPER_WORKERS)
# - 新增: docbot 专属配置 (仓库大小/修订轮次/章节上限/并发上限/AES-GCM 密钥/Git 域名白名单等)
# - 端口: 8068 (与 researcher 8066 区分, 支持同机并存)
# - AGENT_NAME 已在 settings.py 硬编码为 agentinsight-docbot, 无需环境变量

# ========== 环境与部署 ==========
ENV=dev
ENABLE_TEST_PAGE=true

# ========== LLM 网关 ==========
# FAST_LLM: 意图分类/JSON 解析等轻量任务 (需配置对应 API Key)
FAST_LLM=zhipuai/glm-4-flash
SMART_LLM=deepseek/deepseek-v4-flash
STRATEGIC_LLM=deepseek/deepseek-v4-pro
MAX_TOTAL_TOKENS=128000

# ========== LLM API Key ==========
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=  # 备选方案 B (qwen-max) 时启用

# ========== 图像生成 (报告配图, 可选) ==========
# 默认启用报告配图 (与 src/config/settings.py 默认值一致)
# 留空 IMAGE_API_KEY 时复用 DEEPSEEK_API_KEY
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=deepseek/deepseek-v4-flash
IMAGE_API_KEY=
# SVG 矢量配图 (DeepSeek V4 Flash 经 /chat/completions 生成 SVG 代码)
IMAGE_OUTPUT_FORMAT=svg
IMAGE_SVG_MAX_TOKENS=16384
IMAGE_SVG_TEMPERATURE=0.7

# ========== 向量库 Qdrant ==========
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ========== Embeddings ==========
EMBEDDINGS_BASE_URL=http://embeddings:8088
EMBEDDINGS_API_KEY=

# ========== Rerank ==========
RERANK_ENABLED=false
RERANK_BASE_URL=http://rerank:8089
RERANK_API_KEY=

# ========== PostgreSQL ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agis
POSTGRES_PASSWORD=
POSTGRES_DB=agents

# ========== Redis ==========
REDIS_URL=redis://redis:6379/0
REDIS_AUTH=

# ========== 可观测性 ==========
AGENTINSIGHT_PUBLIC_KEY=
AGENTINSIGHT_SECRET_KEY=
AGENTINSIGHT_HOST=https://agent.goldebridge.com

# ========== 用户身份 ==========
# 无 JWT Token 时按客户端 IP 生成确定性 UserId
SELF_HOST=True
# 每日报告生成限额 (按 IP 限流, 默认 5 次/日, 仅报告成功才计数; 0=不限制)
IP_DAILY_REPORT_LIMIT=5

# ========== CORS ==========
# 不推荐 * (暴露面过大), 生产推荐具体域名列表
# 端口 8068 (与 researcher 8066 区分)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8068

# ========== JWT 本地解析 (复用 AgentInsightService JWT 规格) ==========
# 密钥仅环境变量注入, 禁止入仓/硬编码
JWT_SIGNING_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
# JWT_ALGORITHM=HS256  # 固定值, 无需配置
# JWT_CLOCK_SKEW=5  # 默认 5s, 无需配置
# JWT_LOCAL_VERIFY=true  # 默认启用, 无需配置

# ========== docbot 专属配置 ==========

# --- 仓库大小与并发限制 ---
# 仓库大小限制 (MB), 克隆后校验, 超出拒绝
MAX_REPO_SIZE_MB=1024
# D-E 修订循环每章节最多修订轮次 (防止 LLM 死循环)
MAX_REVISIONS_PER_CHAPTER=3
# 单份文档最大章节数 (超出截断)
MAX_CHAPTERS_PER_REPORT=20
# 单次请求最多并发派发 B 子图数 (多文档类型并行生成)
MAX_CONCURRENT_REPORTS=3
# 全局 LLM 调用并发上限 (跨节点共享 Semaphore)
MAX_LLM_CONCURRENCY=5
# RAG 检索并发上限
MAX_RAG_CONCURRENCY=10

# --- 上下文与缓存 ---
# 单次 LLM 调用上下文最大字符数 (超出走上下文压缩)
CONTEXT_MAX_CHARS=500000

# --- 仓库克隆与认证 ---
# AES-GCM 加密密钥 (32 字节, hex 64 字符或 base64 编码)
# 用于加密 user_git_repos 表的 token/password/ssh_key 字段
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
# 警告: 密钥变更后历史加密字段无法解密, 需重新录入仓库配置
GIT_CREDENTIAL_KEY=
# 允许的 Git 域名白名单 (逗号分隔, 空表示允许全部)
# 防止 LLM 注入内网渗透, 生产环境建议显式列出 (如: github.com,gitlab.com,gitee.com)
ALLOWED_GIT_DOMAINS=

# 注: REPO_CLONE_ROOT / DOCBOT_CACHE_TTL / DOCBOT_OUTLINES_DIR 已移至 config/settings.py
# 注: 系统 MCP 子进程配置 (MCP_GIT_*/MCP_FILESYSTEM_*) 已移至 config/settings.py
# 注: 报告语言与类型 (REPORT_LANGUAGE/SUPPORTED_REPORT_TYPES/SUPPORTED_LANGUAGES) 已移至 config/settings.py
