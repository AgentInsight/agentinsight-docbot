# agentinsight-docbot Dockerfile (QA/生产离线模式)
# 多阶段构建 + 非 root + 离线安装 + python:3.12-slim
# 禁止: 部署时联网拉镜像/装依赖/下模型; latest 标签
# 离线模式: 所有依赖预下载到 packages/ (wheels/debs/tools/models)
#
# 与 researcher/Dockerfile.offline 的差异:
# - 端口: 8068 (researcher 是 8066), HEALTHCHECK 检查 8068
# - 不需要 SearXNG (docbot 不依赖 SearXNG 搜索)
# - 不需要 Playwright chromium (docbot 不抓取网页, 代码结构保留注释以备将来需要)
# - Builder 阶段需安装 cairo 系统库 (cairosvg 依赖, DOCX/PDF SVG 配图渲染, docbot requirements 含 cairosvg)
# - 需要 git (GitMCPAdapter 直接调用 git 命令: clone/pull/ls-remote/grep/log)
# - 需要 uv/uvx (运行 mcp-server-git Python MCP 服务)
# - 需要 Node.js + npm (运行 mcp-server-filesystem Node.js MCP 服务)
# - 业务代码 COPY 路径加 agentinsight-docbot/ 前缀 (构建上下文为根目录)
# - 必需目录: /app/data/sessions, /tmp/uploads, /tmp/repos (settings.repo_clone_root)

# ========== Builder 阶段: 离线安装 Python wheel ==========
FROM python:3.12-slim AS builder

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 离线安装 cairo 系统库 (cairosvg 依赖, DOCX/PDF SVG 配图渲染)
# 与 researcher 差异: docbot 的 requirements.txt 含 cairosvg, 需先装 cairo 系统库才能 pip install
# 预下载 libcairo2/libcairo2-dev 等 .deb 到 packages/debs/ (与 runtime 共用 debs 目录)
# 循环 dpkg -i 解决依赖顺序 (离线安装标准技巧)
COPY packages/debs/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb 2>/dev/null; \
    dpkg -i /tmp/debs/*.deb 2>/dev/null; \
    dpkg -i /tmp/debs/*.deb; \
    rm -rf /tmp/debs && ldconfig

# 离线安装 Python 依赖 (--no-index 禁联网)
# 预下载 wheel 包到 packages/wheels/ (宿主机 pip download)
# 构建上下文为根目录, requirements.txt 路径需加 agentinsight-docbot/ 前缀
COPY packages/wheels/ /app/packages/
COPY agentinsight-docbot/requirements.txt .
RUN pip install --no-index --find-links=/app/packages -r requirements.txt

# ========== Runtime 阶段 ==========
FROM python:3.12-slim AS runtime

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 离线安装运行时系统 .deb (含 libcairo2/libpango/fonts-noto-cjk/git 等)
# 预下载 .deb 到 packages/debs/ (宿主机通过 prepare-debs-packages.ps1 脚本预下载)
# 任务1: 需预下载中文字体 .deb 到 packages/debs/ (PDF/DOCX 报告中文显示):
#   fonts-noto-cjk, fonts-noto-cjk-extra, fonts-wqy-zenhei, fonts-wqy-microhei
# 任务 E03: 需预下载 git .deb 到 packages/debs/ (GitMCPAdapter 直接调用 git 命令):
#   git, git-man, liberror-perl, perl, libperl5.40, perl-modules-5.40, libgdbm-compat4t64
# docbot 还需运行时共享库 (WeasyPrint/lxml/psycopg 依赖):
#   libpango-1.0-0, libpangocairo-1.0-0, libcairo2, libgdk-pixbuf-2.0-0, libxml2, libxslt1.1,
#   libpq5, fonts-dejavu-core, ca-certificates, curl, gnupg, openssh-client
# 预下载脚本 (宿主机执行, 需联网): scripts/prepare-debs-packages.ps1
COPY packages/debs/ /tmp/debs/
# 循环 dpkg -i 解决依赖顺序 (离线安装标准技巧)
RUN dpkg -i /tmp/debs/*.deb 2>/dev/null; \
    dpkg -i /tmp/debs/*.deb 2>/dev/null; \
    dpkg -i /tmp/debs/*.deb; \
    rm -rf /tmp/debs && ldconfig; \
    # 任务1: 验证中文字体已安装 (PDF/DOCX 报告需要)
    if ! fc-list | grep -qi "noto sans cjk\|wenquanyi"; then \
        echo "[WARNING] 中文字体未安装 (fonts-noto-cjk/fonts-wqy-*), PDF/DOCX 报告将乱码. 请预下载字体 .deb 到 packages/debs/"; \
    fi; \
    # E03: 验证 git 已安装 (GitMCPAdapter 调用 git 命令: clone/pull/ls-remote/grep/log)
    # 离线模式硬约束: 禁止 apt-get fallback 联网下载, 缺失时仅警告, 不阻断构建
    if ! command -v git >/dev/null 2>&1; then \
        echo "[WARNING] git 未安装 (GitMCPAdapter 将不可用). 请预下载 git .deb 到 packages/debs/ (运行 scripts/prepare-debs-packages.ps1)"; \
    fi

# 离线安装 Node.js 22 LTS + 预装 MCP npm 包
# 预下载 Node.js 二进制到 packages/tools/nodejs/, npm 全局包到 packages/tools/npm-pkgs/
# 准备脚本: scripts/prepare-nodejs-packages.ps1 (Windows) / .sh (Linux)
# 若未运行准备脚本, Node.js 不会安装, MCP 服务将不可用 (不阻断构建)
# docbot 用途: 通过 npx 运行 mcp-server-filesystem (Node.js MCP 服务)
COPY packages/tools/nodejs/ /tmp/nodejs/
COPY packages/tools/npm-pkgs/ /tmp/npm-pkgs/
RUN if ls /tmp/nodejs/node-v*-linux-x64.tar.gz 2>/dev/null 1>&2; then \
        echo "[Node.js] 安装 Node.js 22 LTS (离线)"; \
        tar -xzf /tmp/nodejs/node-v*-linux-x64.tar.gz -C /usr/local --strip-components=1 --no-same-owner; \
        node --version && npm --version && npx --version; \
    else \
        echo "[Node.js] 未找到预下载二进制, 跳过安装 (mcp-server-filesystem 将不可用)"; \
    fi && \
    if ls /tmp/npm-pkgs/node-global.tar.gz 2>/dev/null 1>&2; then \
        echo "[npm] 预装 MCP npm 包到全局 (离线, 含 @modelcontextprotocol/server-filesystem)"; \
        mkdir -p /usr/local/lib/node_modules; \
        tar -xzf /tmp/npm-pkgs/node-global.tar.gz -C /usr/local/lib/node_modules --strip-components=1; \
        ls /usr/local/lib/node_modules/ | head -5; \
    else \
        echo "[npm] 未找到预打包 npm 全局包, 跳过预装"; \
    fi && \
    rm -rf /tmp/nodejs /tmp/npm-pkgs && \
    # 离线模式: 将全局 npm 包的 bin 软链接到 /usr/local/bin \
    # 修复 npx 离线解析: npx 不从 NODE_PATH 解析包 (查找顺序: local node_modules/.bin \
    #   -> npx 自己缓存 ~/.npm/_npx -> 远程 registry), 但 npx 会从 PATH 查找可执行文件, \
    #   预装到 /usr/local/lib/node_modules 的全局包对 npx 不可见, 故需软链接 bin 到 PATH \
    # 对每个全局包, 解析 package.json 的 bin 字段 (支持 string/object 两种形式) 并软链接 \
    if [ -x /usr/local/bin/node ] && [ -d /usr/local/lib/node_modules ]; then \
        echo "[npm] 软链接全局包 bin 到 /usr/local/bin (npx 离线解析修复)"; \
        for pkg_dir in /usr/local/lib/node_modules/*/; do \
            [ -f "$pkg_dir/package.json" ] || continue; \
            node -e "const path=require('path');const d=process.argv[1];const p=require(path.join(d,'package.json'));const b=p.bin;if(typeof b==='string'){let n=p.name||'';if(n.startsWith('@'))n=n.split('/').pop();console.log(n+' '+path.resolve(d,b))}else if(b&&typeof b==='object'){for(const k in b)console.log(k+' '+path.resolve(d,b[k]))}" "$pkg_dir" 2>/dev/null | while IFS=' ' read -r name target; do \
                if [ -f "$target" ]; then \
                    ln -sf "$target" "/usr/local/bin/$name" 2>/dev/null || true; \
                    echo "  linked: $name -> $target"; \
                fi; \
            done; \
        done; \
    fi

# 设置 npm 离线模式 (避免 npx 启动时尝试联网检查, 加速启动)
ENV NPM_CONFIG_OFFLINE=true \
    NODE_PATH=/usr/local/lib/node_modules

# 离线安装 uv/uvx (运行 PyPI MCP 服务, 如 mcp-server-git)
# 预下载 uv 二进制 tarball 到 packages/tools/uv/uv-x86_64-linux.tar.gz
# 准备脚本: scripts/prepare-uv-packages.ps1 (Windows) / .sh (Linux)
# 若未运行准备脚本, uv 不会安装, uvx 类 MCP 不可用 (不阻断构建)
# docbot 用途: 通过 uvx 运行 mcp-server-git (Python MCP 服务)
COPY packages/tools/uv/ /tmp/uv/
RUN if ls /tmp/uv/uv-*-linux.tar.gz 2>/dev/null 1>&2; then \
        echo "[uv] 安装 uv (离线)"; \
        tar -xzf /tmp/uv/uv-*-linux.tar.gz -C /tmp/uv --strip-components=1; \
        cp /tmp/uv/uv /usr/local/bin/uv; \
        cp /tmp/uv/uvx /usr/local/bin/uvx; \
        chmod +x /usr/local/bin/uv /usr/local/bin/uvx; \
        uv --version && uvx --version; \
    else \
        echo "[uv] 未找到预下载二进制, 跳过安装 (mcp-server-git 将不可用)"; \
    fi && \
    rm -rf /tmp/uv

# 离线模式: 不执行 uv tool install mcp-server-git (避免联网拉取)
# docbot 通过 uvx 运行 mcp-server-git, uvx 会从本地缓存查找
# 如需预装 mcp-server-git, 请将其 wheel 预下载到 packages/wheels/ 中
# 离线模式: 不执行 npm install -g @modelcontextprotocol/server-filesystem (避免联网拉取)
# docbot 通过 npx -y 运行 mcp-server-filesystem, 已从 packages/tools/npm-pkgs/ 预装到全局
# (node-global.tar.gz 应已包含 @modelcontextprotocol/server-filesystem)

# 复制 Python site-packages (含已安装依赖)
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 创建非 root 用户 + 必需目录
# - /app/data/sessions: 会话数据持久化
# - /tmp/uploads: 上传文件临时目录 (兼容 AIR 遗留)
# - /tmp/repos: 用户代码仓库克隆根目录 (settings.repo_clone_root, 命名卷挂载)
# 与 researcher 差异: docbot 额外需要 /tmp/repos 目录 (GitMCPAdapter 克隆用户代码仓库)
RUN groupadd -r agent && useradd -r -g agent -d /app -s /sbin/nologin agent \
    && mkdir -p /app/data/sessions /tmp/uploads /tmp/repos \
    && chown -R agent:agent /app /tmp/uploads /tmp/repos

# 复制业务代码 (构建上下文为根目录, 业务代码在 agentinsight-docbot/ 下, 需加前缀)
# 与 researcher 差异: 路径从 . 改为 agentinsight-docbot/ (构建上下文不同)
COPY --chown=agent:agent agentinsight-docbot/ .

# 离线预装 tree-sitter-language-pack parser 二进制 (P1-5.2.1/P1-5.2.2/P2-5.4.2 依赖)
# tree-sitter-language-pack==1.13.5 运行时按需从 GitHub releases 下载 parser .so, 离线环境无法下载
# 预下载方法 (宿主机联网执行):
#   docker run --rm -v packages/tools/tree-sitter-cache:/out python:3.12-slim sh -c \
#     "pip install tree-sitter-language-pack==1.13.5 && \
#      python -c 'import tree_sitter_language_pack as m; m.prefetch([\"python\",\"javascript\",\"typescript\",\"go\",\"java\",\"rust\",\"c\",\"cpp\"])' && \
#      cp -r /root/.cache/tree-sitter-language-pack/v1.13.5 /out/ && \
#      cd /out && tar -czf tree-sitter-cache.tar.gz v1.13.5"
# 解压到 /app/.cache/tree-sitter-language-pack/ (agent 用户 home=/app, cache_dir 默认 /app/.cache/tree-sitter-language-pack/v1.13.5/libs)
COPY packages/tools/tree-sitter-cache/tree-sitter-cache.tar.gz /tmp/tree-sitter-cache.tar.gz
RUN mkdir -p /app/.cache/tree-sitter-language-pack && \
    tar -xzf /tmp/tree-sitter-cache.tar.gz -C /app/.cache/tree-sitter-language-pack/ && \
    rm -f /tmp/tree-sitter-cache.tar.gz && \
    chown -R agent:agent /app/.cache

# FastEmbed ONNX 模型文件 (bge-small-zh-v1.5, 上下文压缩精排用)
# 离线模式: 模型文件通过 docker-compose-qa.yml/docker-compose-offline.yml bind mount 挂载 (只读)
# 路径: ./packages/models/bge-small-zh-v1.5-onnx:/app/models/bge-small-zh-v1.5-onnx:ro

USER agent

# 构建时强校验 litellm 已正确安装 (避免运行时 ModuleNotFoundError)
# 重建镜像须加 --no-cache: docker compose -p agentinsight build --no-cache (确保 litellm 被重新安装)
# 注意: litellm 库不暴露 __version__ 属性, 用 importlib.metadata.version 读取
# 与 researcher 一致 (litellm 是 LLM 网关核心依赖)
RUN python -c "import litellm; from importlib.metadata import version; print(f'litellm version: {version(\"litellm\")}')" || \
    (echo "ERROR: litellm not installed, rebuild required" && exit 1)

# 与 researcher 差异: docbot 端口为 8068 (researcher 是 8066)
EXPOSE 8068

# 与 researcher 差异: HEALTHCHECK 检查 8068 端口 (researcher 检查 8066)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import httpx; r=httpx.get('http://localhost:8068/health', timeout=5.0); assert r.status_code==200" || exit 1

CMD ["python", "server.py"]
